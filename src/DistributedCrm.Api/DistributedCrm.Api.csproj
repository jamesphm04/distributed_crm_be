    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DistributedCrm.Application\DistributedCrm.Application.csproj" />
    <ProjectReference Include="..\DistributedCrm.Infrastructure\DistributedCrm.Infrastructure.csproj" />
  </ItemGroup>

